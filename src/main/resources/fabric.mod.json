  "authors": [],
  "contact": {},
  "license": "GPL-3.0-only",
  "icon": "assets/squidchat/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.squidpowered.squidchat.SquidChat"
    ],
    "client": [
      "com.squidpowered.squidchat.SquidChatClient"
    ]
  },
  "mixins": [
    "squidchat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.6",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
